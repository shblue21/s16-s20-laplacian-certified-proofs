#!/usr/bin/env python3
"""Small SHA-256 compatibility command for the frozen order-16 replay."""

from __future__ import annotations

import hashlib
import pathlib
import sys


def digest(path: pathlib.Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            value.update(block)
    return value.hexdigest()


def check_manifest(path: pathlib.Path) -> int:
    failed = False
    for line_number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not raw:
            continue
        try:
            expected, relative = raw.split("  ", 1)
        except ValueError:
            print(f"{path}:{line_number}: malformed checksum line", file=sys.stderr)
            failed = True
            continue
        target = pathlib.Path(relative)
        try:
            actual = digest(target)
        except OSError as error:
            print(f"{relative}: FAILED open or read ({error})")
            failed = True
            continue
        if actual == expected.lower():
            print(f"{relative}: OK")
        else:
            print(f"{relative}: FAILED")
            failed = True
    return 1 if failed else 0


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] in ("-c", "--check"):
        return check_manifest(pathlib.Path(argv[2]))
    if len(argv) < 2:
        print("usage: sha256sum FILE... | sha256sum -c MANIFEST", file=sys.stderr)
        return 2
    for name in argv[1:]:
        path = pathlib.Path(name)
        print(f"{digest(path)}  {name}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
